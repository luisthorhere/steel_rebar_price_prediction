{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: main.py with Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/src",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "justMyCode": true,
      "args": [
        "main:app",
        "--reload",
        "--host", "127.0.0.1",
        "--port", "8009"
      ],
    }
  ]
}